<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- ==========[Mashed_Lynian_PurrserkerNotes]==========-->
	<ThingDef ParentName="BookBase">
		<defName>Mashed_Lynian_PurrserkerNotes</defName>
		<label>purrserker notes</label>
		<description>A book containing several notes and observations on Purrserkers, Lynians able to unleash their furry fury. It's seen better days, but reading it should be able to help a Lynian gain knowledge of new abilities.</description>
		<graphicData>
			<texPath>Things/Item/Book/Mashed_Lynian_LynianNotes/Mashed_Lynian_LynianNotes</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<uiIconPath>Things/Item/Book/Mashed_Lynian_LynianNotes/Mashed_Lynian_LynianNotes</uiIconPath>
		<statBases>
			<MarketValue>150</MarketValue>
		</statBases>
		<thingSetMakerTags inherit="False"/>
		<comps>
			<li Class="CompProperties_Book">
				<nameMaker>Mashed_Lynian_Namer_LynianNotes</nameMaker>
				<descriptionMaker>Mashed_Lynian_Description_LynianNotes</descriptionMaker>
				<ageYearsRange>100~200</ageYearsRange>
				<openGraphic>
					<texPath>Things/Item/Book/Mashed_Lynian_LynianNotes/Mashed_Lynian_LynianNotes_Open</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>0.7</drawSize>
				</openGraphic>
				<verticalGraphic>
					<texPath>Things/Item/Book/Mashed_Lynian_LynianNotes/Mashed_Lynian_LynianNotes_Vertical</texPath>
					<graphicClass>Graphic_Multi</graphicClass>
					<addTopAltitudeBias>true</addTopAltitudeBias>
				</verticalGraphic>
				<doers>
					<li Class="Mashed_Lynians.BookOutcomeProperties_GainLynianKnowledge">
						<knowledgeDef>Mashed_Lynian_Purrserker</knowledgeDef>
					</li>
				</doers>
			</li>
		</comps>
	</ThingDef>
</Defs>